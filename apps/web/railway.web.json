{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "corepack enable && yarn install --immutable && yarn build:web:deploy",
    "watchPatterns": [
      "apps/web/**",
      "packages/db/**",
      "packages/types/**",
      "package.json",
      "yarn.lock"
    ]
  },
  "deploy": {
    "startCommand": "yarn workspace web start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "sleepApplication": true,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 0,
    "drainingSeconds": 0
  }
}
