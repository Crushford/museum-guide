generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Artifact {
  id               Int        @id @default(autoincrement())
  name             String
  slug             String
  knowledgeText    String?
  furtherReading   String[]   @default([])
  roomId           Int
  museumId         Int
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  room             Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  museum           Museum     @relation(fields: [museumId], references: [id], onDelete: Cascade)
  content          Content[]

  @@unique([slug, museumId])
  @@index([roomId])
  @@index([museumId])
}

model Content {
  id         Int       @id @default(autoincrement())
  text       String
  type       String?
  museumId   Int?
  roomId     Int?
  artifactId Int?
  llmProvider String
  model       String
  prompt      String
  audioUrl    String?
  createdAt  DateTime  @default(now())
  Artifact   Artifact? @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  Museum     Museum?   @relation(fields: [museumId], references: [id], onDelete: Cascade)
  Room       Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Museum {
  id             Int       @id @default(autoincrement())
  name           String
  slug           String    @unique
  knowledgeText  String?
  furtherReading String[]  @default([])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  rooms          Room[]
  artifacts      Artifact[]
  content        Content[]

  @@index([slug])
}

model Room {
  id             Int        @id @default(autoincrement())
  name           String
  slug           String
  knowledgeText  String?
  furtherReading String[]   @default([])
  museumId       Int
  parentRoomId   Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  museum         Museum     @relation(fields: [museumId], references: [id], onDelete: Cascade)
  parentRoom     Room?      @relation("RoomToRoom", fields: [parentRoomId], references: [id], onDelete: Cascade)
  childRooms     Room[]     @relation("RoomToRoom")
  artifacts       Artifact[]
  content        Content[]

  @@unique([slug, museumId])
  @@index([museumId])
  @@index([parentRoomId])
}
