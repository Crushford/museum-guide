generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Artifact {
  id                   Int          @id @default(autoincrement())
  displayTitle         String       @map("name")
  localTitle           String?
  localTitleLanguage   String?
  englishTitle         String?
  rawPlaqueText        String?
  knowledgeTextEn      String?
  slug                 String       @default(dbgenerated())
  furtherReading       String[]     @default([])
  wikidataId           String?      @unique
  wikipediaUrl         String?
  wikimediaImageUrl    String?
  wikipediaSummary     String?
  wikipediaSummaryLang String? // Original language code (e.g., "de", "en")
  roomId               Int?
  museumId             Int
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  room                 Room?        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  museum               Museum       @relation(fields: [museumId], references: [id], onDelete: Cascade)
  content              Content[]
  plaqueScans          PlaqueScan[]

  @@unique([slug, museumId])
  @@index([roomId])
  @@index([museumId])
}

model PlaqueScan {
  id          Int      @id @default(autoincrement())
  artifactId  Int
  museumId    Int
  imageUrl    String
  rawText     String
  ocrMetadata Json?
  createdAt   DateTime @default(now())
  artifact    Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  museum      Museum   @relation(fields: [museumId], references: [id], onDelete: Cascade)

  @@index([artifactId])
  @@index([museumId])
}

model Content {
  id              Int       @id @default(autoincrement())
  text            String
  type            String?
  museumId        Int?
  roomId          Int?
  artifactId      Int?
  llmProvider     String
  model           String
  prompt          String
  promptVersion   String    @default("1.0")
  isAdultContent  Boolean   @default(false)
  sensitiveTopics String[]  @default([])
  subjectTags     String[]  @default([])
  audioUrl        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  Artifact        Artifact? @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  Museum          Museum?   @relation(fields: [museumId], references: [id], onDelete: Cascade)
  Room            Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Museum {
  id                  Int       @id @default(autoincrement())
  name                String
  slug                String    @unique @default(dbgenerated())
  knowledgeText       String?
  furtherReading      String[]  @default([])
  wikidataId          String?   @unique
  citySlug            String?
  wikipediaUrl        String?
  coordinates         Json?
  image               String?
  locationTags        String[]  @default([])
  description         String?
  wikipediaSummary    String?
  officialWebsite     String?
  museumHydratedAt    DateTime?
  artifactsHydratedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  rooms       Room[]
  artifacts   Artifact[]
  plaqueScans PlaqueScan[]
  content     Content[]

  @@index([citySlug])
}

model Room {
  id             Int        @id @default(autoincrement())
  name           String
  slug           String     @default(dbgenerated())
  knowledgeText  String?
  furtherReading String[]   @default([])
  museumId       Int
  parentRoomId   Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  museum         Museum     @relation(fields: [museumId], references: [id], onDelete: Cascade)
  parentRoom     Room?      @relation("RoomToRoom", fields: [parentRoomId], references: [id], onDelete: Cascade)
  childRooms     Room[]     @relation("RoomToRoom")
  artifacts      Artifact[]
  content        Content[]

  @@unique([slug, museumId])
  @@index([museumId])
  @@index([parentRoomId])
}

model ApiCall {
  id           Int      @id @default(autoincrement())
  service      String
  endpoint     String
  durationMs   Int
  status       String
  statusCode   Int?
  inputTokens  Int?
  outputTokens Int?
  model        String?
  costEur      Float?
  contentId    Int?
  artifactId   Int?
  metadata     Json?
  error        String?
  createdAt    DateTime @default(now())

  @@index([service])
  @@index([costEur])
  @@index([contentId])
  @@index([artifactId])
  @@index([createdAt])
}
