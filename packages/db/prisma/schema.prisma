generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Artifact {
  id             Int       @id @default(autoincrement())
  name           String
  slug           String    @unique @default(dbgenerated("generate_slug(name)"))
  knowledgeText  String?
  furtherReading String[]  @default([])
  roomId         Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  room           Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  content        Content[]

  @@index([roomId])
  @@index([slug])
}

model Content {
  id         Int       @id @default(autoincrement())
  text       String
  type       String?
  museumId   Int?
  roomId     Int?
  artifactId Int?
  createdAt  DateTime  @default(now())
  Artifact   Artifact? @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  Museum     Museum?   @relation(fields: [museumId], references: [id], onDelete: Cascade)
  Room       Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Museum {
  id             Int       @id @default(autoincrement())
  name           String
  slug           String    @unique @default(dbgenerated("generate_slug(name)"))
  knowledgeText  String?
  furtherReading String[]  @default([])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  rooms          Room[]
  content        Content[]

  @@index([slug])
}

model Room {
  id             Int        @id @default(autoincrement())
  name           String
  slug           String    @unique @default(dbgenerated("generate_slug(name)"))
  knowledgeText  String?
  furtherReading String[]   @default([])
  museumId       Int?
  parentRoomId   Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  museum         Museum?    @relation(fields: [museumId], references: [id], onDelete: Cascade)
  parentRoom     Room?      @relation("RoomToRoom", fields: [parentRoomId], references: [id], onDelete: Cascade)
  childRooms     Room[]     @relation("RoomToRoom")
  artifacts       Artifact[]
  content        Content[]

  @@index([museumId])
  @@index([parentRoomId])
  @@index([slug])
}
