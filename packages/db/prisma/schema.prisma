// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Museum {
  id               Int       @id @default(autoincrement())
  name             String
  knowledgeText    String?
  furtherReading   String[]  @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  rooms            Room[]
  content          Content[]
}

model Room {
  id               Int       @id @default(autoincrement())
  name             String
  museumId         Int?      // Optional - only set if top-level room
  parentRoomId     Int?      // Optional - only set if nested room
  knowledgeText    String?
  furtherReading   String[]  @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  museum           Museum?   @relation(fields: [museumId], references: [id], onDelete: Cascade)
  parentRoom       Room?     @relation("RoomHierarchy", fields: [parentRoomId], references: [id], onDelete: Cascade)
  childRooms       Room[]    @relation("RoomHierarchy")
  artifacts        Artifact[]
  content          Content[]

  @@index([museumId])
  @@index([parentRoomId])
}

model Artifact {
  id               Int       @id @default(autoincrement())
  name             String
  roomId           Int
  knowledgeText    String?
  furtherReading   String[]  @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  room             Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  content          Content[]

  @@index([roomId])
}

model Content {
  id          Int      @id @default(autoincrement())
  text        String
  type        String?
  museumId    Int?
  roomId      Int?
  artifactId  Int?
  createdAt   DateTime @default(now())

  museum   Museum?  @relation(fields: [museumId], references: [id], onDelete: Cascade)
  room     Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  artifact Artifact? @relation(fields: [artifactId], references: [id], onDelete: Cascade)
}

